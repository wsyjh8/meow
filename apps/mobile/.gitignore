# Android Gradle Kotlin DSL cache
/android/.kotlin/

# Need #11 enrichment JSONL — local-only debug seed copies of docs/forms/.
# Do not check these in: keep the repo lean, source of truth lives in docs/.
# To populate locally: cp ../../docs/forms/*.jsonl assets/forms/
/assets/forms/

# Need #11 prebuilt SQLite seed — generated by
# tools/build_enrichment_seed.dart from docs/forms/. Checked into the
# repo so every clone / worktree / CI run can `flutter run` without a
# manual bootstrap step. Regenerate and re-commit when you change the
# seed schema or refresh the source JSONL:
#   dart run tools/build_enrichment_seed.dart
