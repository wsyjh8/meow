# PR-C: pipeline.py local .env example.
# Copy to .env (gitignored) and fill in your real values.
#
# `pipeline.py` auto-loads .env from this directory at import time
# (python-dotenv + load_dotenv(Path(__file__).parent / '.env')), so no
# manual `export` needed before invocation.

# ----- Postgres -----
# pipeline.py only reads DATABASE_URL (R3 P1 + R4-1: NOT PG* split env).
# `_connect_or_die()` line 69 reads os.environ.get("DATABASE_URL").
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/meow_dev

# (Recommended) Connect to production DB via SSH tunnel:
#   ssh -L 5432:localhost:5432 user@your-server-ip
# then:
#   DATABASE_URL=postgresql://postgres:<prod-password>@localhost:5432/meow_prod

# ----- Tencent COS (PR-C) -----
COS_REGION=ap-shanghai
COS_BUCKET=meow-content-mvp-1234567890
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# COS_PUBLIC_URL_BASE = "https://<COS_BUCKET>.cos.<COS_REGION>.myqcloud.com"
COS_PUBLIC_URL_BASE=https://meow-content-mvp-1234567890.cos.ap-shanghai.myqcloud.com
